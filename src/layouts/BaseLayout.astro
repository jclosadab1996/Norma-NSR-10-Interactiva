---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Oculta el header de pestañas de Títulos (no usado por ahora). */
  sinFooter?: boolean;
}

const { title, description = 'Guía interactiva para entender el Reglamento Colombiano de Construcción Sismo Resistente NSR-10.', sinFooter = false } = Astro.props;
const fullTitle = title.includes('NSR-10') ? title : `${title} · NSR-10 Interactiva`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar parpadeo.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {!sinFooter && <Footer />}
  </body>
</html>
