---
/**
 * Inserta una calculadora (isla React) dentro de un capítulo MDX o de una página.
 * Uso en MDX: <CalculadoraEmbed id="espectro-diseno" />
 * Los componentes se importan de forma estática (Astro necesita la ruta del módulo para hidratar);
 * solo se envía al navegador el JS de la calculadora que realmente se usa.
 */
import { calculadoraPorId } from '../../data/calculadoras';
import ZonaAmenaza from '../calc/ZonaAmenaza';
import EfectosLocales from '../calc/EfectosLocales';
import EspectroDiseno from '../calc/EspectroDiseno';
import CoeficienteR from '../calc/CoeficienteR';
import PeriodoFundamental from '../calc/PeriodoFundamental';
import FuerzaHorizontal from '../calc/FuerzaHorizontal';
import DerivaCheck from '../calc/DerivaCheck';
import SeparacionSismica from '../calc/SeparacionSismica';
import UmbralDano from '../calc/UmbralDano';
import Municipios from '../calc/Municipios';
import CombinacionesCarga from '../calc/CombinacionesCarga';
import CargaMuerta from '../calc/CargaMuerta';
import ReduccionCargaViva from '../calc/ReduccionCargaViva';
import EmpozamientoGranizo from '../calc/EmpozamientoGranizo';
import EmpujeTierra from '../calc/EmpujeTierra';
import VientoSimplificado from '../calc/VientoSimplificado';
import VientoExposicion from '../calc/VientoExposicion';
import VientoPresion from '../calc/VientoPresion';
import RecubrimientoDurabilidad from '../calc/RecubrimientoDurabilidad';
import ResistenciaPromedio from '../calc/ResistenciaPromedio';
import DetallesRefuerzo from '../calc/DetallesRefuerzo';
import PropiedadesConcreto from '../calc/PropiedadesConcreto';
import EspesorMinimo from '../calc/EspesorMinimo';
import FlexionViga from '../calc/FlexionViga';
import ColumnaInteraccion from '../calc/ColumnaInteraccion';
import CortanteViga from '../calc/CortanteViga';
import Punzonamiento from '../calc/Punzonamiento';
import LongitudDesarrollo from '../calc/LongitudDesarrollo';
import LosaDosDirecciones from '../calc/LosaDosDirecciones';
import ZapataDiseno from '../calc/ZapataDiseno';
import PreesforzoEsfuerzos from '../calc/PreesforzoEsfuerzos';
import ConfinamientoColumna from '../calc/ConfinamientoColumna';
import AnclajeConcreto from '../calc/AnclajeConcreto';
import FmMamposteria from '../calc/FmMamposteria';
import DesarrolloMamposteria from '../calc/DesarrolloMamposteria';
import DimensionesEfectivas from '../calc/DimensionesEfectivas';
import AxialMamposteria from '../calc/AxialMamposteria';
import FlexionMamposteria from '../calc/FlexionMamposteria';
import MuroFueraPlano from '../calc/MuroFueraPlano';
import MuroEnPlano from '../calc/MuroEnPlano';
import CuantiasMamposteria from '../calc/CuantiasMamposteria';
import MuroConfinadoRefuerzo from '../calc/MuroConfinadoRefuerzo';
import MuroConfinadoResistencia from '../calc/MuroConfinadoResistencia';
import MuroDiafragma from '../calc/MuroDiafragma';
import EsfuerzosAdmisiblesMamposteria from '../calc/EsfuerzosAdmisiblesMamposteria';

interface Props {
  id: string;
  /** Oculta el marco y el encabezado (para páginas que ya los muestran). */
  sinMarco?: boolean;
}
const { id, sinMarco = false } = Astro.props;
const meta = calculadoraPorId(id);
---

{
  sinMarco ? (
    <div class="not-prose">
      {id === 'zona-amenaza' && <ZonaAmenaza client:visible />}
      {id === 'efectos-locales' && <EfectosLocales client:visible />}
      {id === 'espectro-diseno' && <EspectroDiseno client:visible />}
      {id === 'coeficiente-r' && <CoeficienteR client:visible />}
      {id === 'periodo-fundamental' && <PeriodoFundamental client:visible />}
      {id === 'fuerza-horizontal' && <FuerzaHorizontal client:visible />}
      {id === 'deriva' && <DerivaCheck client:visible />}
      {id === 'separacion-sismica' && <SeparacionSismica client:visible />}
      {id === 'umbral-dano' && <UmbralDano client:visible />}
      {id === 'municipios' && <Municipios client:visible />}
      {id === 'combinaciones-carga' && <CombinacionesCarga client:visible />}
      {id === 'carga-muerta' && <CargaMuerta client:visible />}
      {id === 'reduccion-carga-viva' && <ReduccionCargaViva client:visible />}
      {id === 'empozamiento-granizo' && <EmpozamientoGranizo client:visible />}
      {id === 'empuje-tierra' && <EmpujeTierra client:visible />}
      {id === 'viento-simplificado' && <VientoSimplificado client:visible />}
      {id === 'viento-exposicion' && <VientoExposicion client:visible />}
      {id === 'viento-presion' && <VientoPresion client:visible />}
      {id === 'recubrimiento-durabilidad' && <RecubrimientoDurabilidad client:visible />}
      {id === 'resistencia-promedio' && <ResistenciaPromedio client:visible />}
      {id === 'detalles-refuerzo' && <DetallesRefuerzo client:visible />}
      {id === 'propiedades-concreto' && <PropiedadesConcreto client:visible />}
      {id === 'espesor-minimo' && <EspesorMinimo client:visible />}
      {id === 'flexion-viga' && <FlexionViga client:visible />}
      {id === 'columna-interaccion' && <ColumnaInteraccion client:visible />}
      {id === 'cortante-viga' && <CortanteViga client:visible />}
      {id === 'punzonamiento' && <Punzonamiento client:visible />}
      {id === 'longitud-desarrollo' && <LongitudDesarrollo client:visible />}
      {id === 'losa-dos-direcciones' && <LosaDosDirecciones client:visible />}
      {id === 'zapata-diseno' && <ZapataDiseno client:visible />}
      {id === 'preesforzo-esfuerzos' && <PreesforzoEsfuerzos client:visible />}
      {id === 'confinamiento-columna' && <ConfinamientoColumna client:visible />}
      {id === 'anclaje-concreto' && <AnclajeConcreto client:visible />}
      {id === 'fm-mamposteria' && <FmMamposteria client:visible />}
      {id === 'desarrollo-mamposteria' && <DesarrolloMamposteria client:visible />}
      {id === 'dimensiones-efectivas' && <DimensionesEfectivas client:visible />}
      {id === 'axial-mamposteria' && <AxialMamposteria client:visible />}
      {id === 'flexion-mamposteria' && <FlexionMamposteria client:visible />}
      {id === 'muro-fuera-plano' && <MuroFueraPlano client:visible />}
      {id === 'muro-en-plano' && <MuroEnPlano client:visible />}
      {id === 'cuantias-mamposteria' && <CuantiasMamposteria client:visible />}
      {id === 'muro-confinado-refuerzo' && <MuroConfinadoRefuerzo client:visible />}
      {id === 'muro-confinado-resistencia' && <MuroConfinadoResistencia client:visible />}
      {id === 'muro-diafragma' && <MuroDiafragma client:visible />}
      {id === 'esfuerzos-admisibles-mamposteria' && <EsfuerzosAdmisiblesMamposteria client:visible />}
    </div>
  ) : (
    <section id={`calc-${id}`} class="not-prose my-8 scroll-mt-24 rounded-2xl border border-chart-2/40 bg-card shadow-sm" aria-label={`Calculadora: ${meta?.nombre ?? id}`}>
      <header class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-chart-2/30 bg-chart-2/10 px-5 py-3">
        <span class="rounded-md bg-chart-2 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-black/80">Calculadora</span>
        <h3 class="text-base font-semibold">{meta?.nombre ?? id}</h3>
        {meta && <span class="ml-auto font-mono text-xs text-muted-foreground">§ {meta.secciones}</span>}
      </header>
      <div class="p-4 sm:p-5">
        {id === 'zona-amenaza' && <ZonaAmenaza client:visible />}
      {id === 'efectos-locales' && <EfectosLocales client:visible />}
      {id === 'espectro-diseno' && <EspectroDiseno client:visible />}
      {id === 'coeficiente-r' && <CoeficienteR client:visible />}
      {id === 'periodo-fundamental' && <PeriodoFundamental client:visible />}
      {id === 'fuerza-horizontal' && <FuerzaHorizontal client:visible />}
      {id === 'deriva' && <DerivaCheck client:visible />}
      {id === 'separacion-sismica' && <SeparacionSismica client:visible />}
      {id === 'umbral-dano' && <UmbralDano client:visible />}
      {id === 'municipios' && <Municipios client:visible />}
      {id === 'combinaciones-carga' && <CombinacionesCarga client:visible />}
      {id === 'carga-muerta' && <CargaMuerta client:visible />}
      {id === 'reduccion-carga-viva' && <ReduccionCargaViva client:visible />}
      {id === 'empozamiento-granizo' && <EmpozamientoGranizo client:visible />}
      {id === 'empuje-tierra' && <EmpujeTierra client:visible />}
      {id === 'viento-simplificado' && <VientoSimplificado client:visible />}
      {id === 'viento-exposicion' && <VientoExposicion client:visible />}
      {id === 'viento-presion' && <VientoPresion client:visible />}
      {id === 'recubrimiento-durabilidad' && <RecubrimientoDurabilidad client:visible />}
      {id === 'resistencia-promedio' && <ResistenciaPromedio client:visible />}
      {id === 'detalles-refuerzo' && <DetallesRefuerzo client:visible />}
      {id === 'propiedades-concreto' && <PropiedadesConcreto client:visible />}
      {id === 'espesor-minimo' && <EspesorMinimo client:visible />}
      {id === 'flexion-viga' && <FlexionViga client:visible />}
      {id === 'columna-interaccion' && <ColumnaInteraccion client:visible />}
      {id === 'cortante-viga' && <CortanteViga client:visible />}
      {id === 'punzonamiento' && <Punzonamiento client:visible />}
      {id === 'longitud-desarrollo' && <LongitudDesarrollo client:visible />}
      {id === 'losa-dos-direcciones' && <LosaDosDirecciones client:visible />}
      {id === 'zapata-diseno' && <ZapataDiseno client:visible />}
      {id === 'preesforzo-esfuerzos' && <PreesforzoEsfuerzos client:visible />}
      {id === 'confinamiento-columna' && <ConfinamientoColumna client:visible />}
      {id === 'anclaje-concreto' && <AnclajeConcreto client:visible />}
      {id === 'fm-mamposteria' && <FmMamposteria client:visible />}
      {id === 'desarrollo-mamposteria' && <DesarrolloMamposteria client:visible />}
      {id === 'dimensiones-efectivas' && <DimensionesEfectivas client:visible />}
      {id === 'axial-mamposteria' && <AxialMamposteria client:visible />}
      {id === 'flexion-mamposteria' && <FlexionMamposteria client:visible />}
      {id === 'muro-fuera-plano' && <MuroFueraPlano client:visible />}
      {id === 'muro-en-plano' && <MuroEnPlano client:visible />}
      {id === 'cuantias-mamposteria' && <CuantiasMamposteria client:visible />}
      {id === 'muro-confinado-refuerzo' && <MuroConfinadoRefuerzo client:visible />}
      {id === 'muro-confinado-resistencia' && <MuroConfinadoResistencia client:visible />}
      {id === 'muro-diafragma' && <MuroDiafragma client:visible />}
      {id === 'esfuerzos-admisibles-mamposteria' && <EsfuerzosAdmisiblesMamposteria client:visible />}
      </div>
      {meta && <p class="border-t px-5 py-2 text-xs text-muted-foreground">{meta.descripcion}</p>}
    </section>
  )
}
