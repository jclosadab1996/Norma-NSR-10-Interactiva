---
/** Cierre destacado de un <Ejemplo> con la conclusión y la verificación. */
interface Props {
  titulo?: string;
}
const { titulo = 'Resultado' } = Astro.props;
---

<div class="rounded-lg border border-ok/40 bg-ok/10 p-3">
  <p class="!my-0 text-xs font-bold uppercase tracking-wider text-ok">{titulo}</p>
  <div class="mt-1 [&>*:last-child]:mb-0"><slot /></div>
</div>
