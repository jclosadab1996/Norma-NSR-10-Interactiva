---
/**
 * Vista de un capítulo/apéndice (cabecera, contenido MDX, navegación y TOC) compartida por todos los Títulos.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import TituloLayout from '../../layouts/TituloLayout.astro';
import Callout from '../content/Callout.astro';
import NormaRef from '../content/NormaRef.astro';
import Ejemplo from '../content/Ejemplo.astro';
import Paso from '../content/Paso.astro';
import Resultado from '../content/Resultado.astro';
import TablaNorma from '../content/TablaNorma.astro';
import Ecuacion from '../content/Ecuacion.astro';
import Detalle from '../content/Detalle.astro';
import Figura from '../content/Figura.astro';
import CalculadoraEmbed from '../content/CalculadoraEmbed.astro';
import { calculadoraPorId } from '../../data/calculadoras';

interface Props {
  titulo: 'a' | 'b';
  entry: CollectionEntry<'titulo-a'> | CollectionEntry<'titulo-b'>;
  anterior?: CollectionEntry<'titulo-a'> | CollectionEntry<'titulo-b'>;
  siguiente?: CollectionEntry<'titulo-a'> | CollectionEntry<'titulo-b'>;
}
const { titulo, entry, anterior, siguiente } = Astro.props;
const base = `/titulo-${titulo}`;
const letra = titulo.toUpperCase();
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const relacionadas = d.calculadoras.map(calculadoraPorId).filter((c) => c !== undefined);
const NIVEL = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado' } as const;
const etiqueta = d.tipo === 'capitulo' ? `Capítulo ${d.codigo}` : `Apéndice ${d.codigo}`;
---
<TituloLayout title={`${etiqueta} — ${d.titulo}`} description={d.resumen} titulo={titulo} actual={entry.id}>
  <div class="flex gap-8">
    <article class="min-w-0 flex-1" data-pagefind-body>
      <header class="mb-8 border-b pb-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">{etiqueta} · Título {letra}</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{d.titulo}</h1>
        <p class="mt-3 text-lg text-muted-foreground">{d.resumen}</p>
        <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted-foreground">
          <div><dt class="inline">En la norma: </dt><dd class="inline font-mono">{d.paginasNorma}</dd></div>
          <div><dt class="inline">PDF: </dt><dd class="inline font-mono">pág. {d.paginaPdf}</dd></div>
          <div><dt class="inline">Nivel: </dt><dd class="inline">{NIVEL[d.nivel]}</dd></div>
        </dl>
        {
          d.objetivos.length > 0 && (
            <div class="mt-5 rounded-xl border bg-card p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-primary">Qué aprenderás</p>
              <ul class="mt-2 grid gap-1.5 text-sm sm:grid-cols-2">
                {d.objetivos.map((o) => (
                  <li class="flex gap-2"><span class="text-ok" aria-hidden="true">✓</span><span>{o}</span></li>
                ))}
              </ul>
            </div>
          )
        }
        {
          relacionadas.length > 0 && (
            <p class="mt-4 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-muted-foreground">Calculadoras de este capítulo:</span>
              {relacionadas.map((c) => (
                <a href={`#calc-${c.id}`} class="rounded-md border bg-chart-2/15 px-2 py-0.5 hover:bg-chart-2/30">{c.nombre}</a>
              ))}
            </p>
          )
        }
      </header>

      <div class="prose-nsr">
        <Content components={{ Callout, NormaRef, Ejemplo, Paso, Resultado, TablaNorma, Ecuacion, Detalle, Figura, CalculadoraEmbed }} />
      </div>

      <nav class="mt-12 grid gap-4 border-t pt-6 sm:grid-cols-2" aria-label="Capítulo anterior y siguiente">
        {
          anterior ? (
            <a href={`${base}/${anterior.id}`} class="rounded-xl border p-4 hover:border-primary/50 hover:bg-accent/40">
              <span class="text-xs text-muted-foreground">← Anterior</span>
              <span class="mt-1 block font-semibold">{anterior.data.codigo} · {anterior.data.titulo}</span>
            </a>
          ) : <span />
        }
        {
          siguiente && (
            <a href={`${base}/${siguiente.id}`} class="rounded-xl border p-4 text-right hover:border-primary/50 hover:bg-accent/40">
              <span class="text-xs text-muted-foreground">Siguiente →</span>
              <span class="mt-1 block font-semibold">{siguiente.data.codigo} · {siguiente.data.titulo}</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="sticky top-[6.5rem] hidden h-[calc(100dvh-7.5rem)] w-56 shrink-0 overflow-y-auto xl:block" aria-label="En esta página">
      {
        toc.length > 0 && (
          <>
            <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">En esta página</p>
            <ul class="space-y-1 border-l text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class:list={['-ml-px block border-l border-transparent py-0.5 text-muted-foreground hover:border-primary hover:text-foreground', h.depth === 2 ? 'pl-3' : 'pl-6 text-xs']}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>
  </div>
</TituloLayout>
