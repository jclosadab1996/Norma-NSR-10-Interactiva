---
import TituloLayout from '../../layouts/TituloLayout.astro';
import GlosarioD from '../../components/calc/GlosarioD';
import { definicionesD, simbolosD } from '../../data/glosarioD';
---

<TituloLayout
  titulo="d"
  title="Glosario y notación del Título D"
  description="Definiciones (D.2.5) y notación (D.2.4) del Título D de la NSR-10, con búsqueda, filtro por tema e índice alfabético."
  actual="d2"
  ancho="amplio"
>
  <header class="mb-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Título D · Capítulo D.2</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">Glosario y notación</h1>
    <p class="mt-3 max-w-3xl text-muted-foreground">
      Las <strong>{definicionesD.length} definiciones</strong> de D.2.5 y los <strong>{simbolosD.length} símbolos</strong> de D.2.4 del Título D, tal
      como los escribe la norma. Busca por término, por símbolo (f′m, Ae, ld…) o por cualquier palabra de la definición. Para aprender a usarlos,
      lee el <a href="/titulo-d/d2" class="font-medium text-primary underline-offset-4 hover:underline">Capítulo D.2 explicado</a>.
    </p>
  </header>
  <GlosarioD client:load />
</TituloLayout>
