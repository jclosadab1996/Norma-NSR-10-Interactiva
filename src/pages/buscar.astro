---
import BaseLayout from '../layouts/BaseLayout.astro';
import Buscador from '../components/calc/Buscador';
---

<BaseLayout title="Buscar" description="Busca en todo el contenido de los Títulos A, B, C y D de la NSR-10 interactiva.">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight">Buscar</h1>
    <p class="mt-2 text-muted-foreground">Busca en los capítulos de los Títulos A, B, C y D: conceptos, secciones (por ejemplo «A.4.2», «B.2.3», «C.10.2» o «D.5.8») o símbolos.</p>
    <div class="mt-6"><Buscador client:load /></div>
  </div>
</BaseLayout>
