---
import { getCollection } from 'astro:content';
import TituloLayout from '../../layouts/TituloLayout.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from '../../lib/utils';
import { calculadorasDe } from '../../data/calculadoras';

const todos = (await getCollection('titulo-c')).sort((a, b) => a.data.orden - b.data.orden || a.id.localeCompare(b.id));
const capitulos = todos.filter((e) => e.data.tipo === 'capitulo');
const apendices = todos.filter((e) => e.data.tipo === 'apendice');

const NIVEL = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado' } as const;
const NIVEL_CLASE = {
  basico: 'bg-ok/15 text-ok',
  intermedio: 'bg-warn/15 text-warn',
  avanzado: 'bg-danger/15 text-danger',
} as const;

const flujo = [
  ['1', 'Materiales y calidad', 'C.3 · C.5', 'Cemento, agregados, acero, aditivos y control de la calidad del concreto.'],
  ['2', 'Durabilidad y detalles', 'C.4 · C.6 · C.7', 'Exposición, recubrimientos, encofrados y detalles del refuerzo.'],
  ['3', 'Análisis y resistencia', 'C.8 · C.9', 'Análisis estructural, combinaciones, factores φ y deflexiones.'],
  ['4', 'Flexión, cortante y desarrollo', 'C.10 – C.12', 'Resistencia de vigas, columnas, cortante, torsión y longitudes de desarrollo.'],
  ['5', 'Sistemas y elementos', 'C.13 – C.20', 'Losas, muros, cimentaciones, prefabricado, preesforzado y evaluación.'],
  ['6', 'Sismo resistencia', 'C.21', 'Detallado de pórticos y muros con capacidad de disipación de energía DMI, DMO y DES.'],
] as const;
---

<TituloLayout titulo="c"
  title="Título C — Concreto estructural"
  description="Guía interactiva del Título C de la NSR-10: materiales, durabilidad, flexión, cortante, columnas, losas, cimentaciones, preesforzado y diseño sismo resistente de estructuras de concreto, con ejemplos y calculadoras."
>
  <header class="rounded-2xl border bg-gradient-to-br from-primary/10 via-background to-chart-2/10 p-6 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Título C</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">Concreto estructural</h1>
    <p class="mt-4 max-w-3xl text-muted-foreground">
      Establece cómo se diseñan y construyen las estructuras de concreto reforzado, preesforzado, prefabricado y simple:
      los materiales y su calidad, la durabilidad, el detallado del refuerzo, la resistencia a flexión, carga axial,
      cortante y torsión, las losas, los muros y las cimentaciones, y los requisitos especiales de sismo resistencia
      (Capítulo C.21).
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`/titulo-c/${capitulos[0]?.id ?? 'c1'}`} class={cn(buttonVariants())}>Empezar por C.1</a>
      <a href="/titulo-c/calculadoras" class={cn(buttonVariants({ variant: 'outline' }))}>Calculadoras</a>
      <a href="/titulo-c/glosario" class={cn(buttonVariants({ variant: 'outline' }))}>Glosario</a>
    </div>
  </header>

  <section class="mt-10" aria-labelledby="h-flujo">
    <h2 id="h-flujo" class="text-2xl font-bold tracking-tight">Del material al diseño sismo resistente, de un vistazo</h2>
    <p class="mt-1 text-sm text-muted-foreground">Ruta recomendada para estudiar el diseño de un elemento de concreto.</p>
    <ol class="mt-5 grid gap-3 md:grid-cols-3 xl:grid-cols-6">
      {
        flujo.map(([n, t, ref, d]) => (
          <li class="relative rounded-xl border bg-card p-4">
            <span class="absolute -top-3 left-4 grid size-6 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground">{n}</span>
            <p class="mt-1 font-semibold leading-snug">{t}</p>
            <p class="mt-1 font-mono text-xs text-muted-foreground">§ {ref}</p>
            <p class="mt-2 text-sm text-muted-foreground">{d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="h-caps">
    <h2 id="h-caps" class="text-2xl font-bold tracking-tight">Capítulos</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {
        capitulos.map((c) => (
          <li>
            <a href={`/titulo-c/${c.id}`} class="group flex h-full flex-col rounded-xl border bg-card p-5 transition hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-lg font-bold text-primary">{c.data.codigo}</span>
                <span class={`rounded-full px-2 py-0.5 text-xs ${NIVEL_CLASE[c.data.nivel]}`}>{NIVEL[c.data.nivel]}</span>
              </div>
              <h3 class="mt-2 font-semibold leading-snug group-hover:text-primary">{c.data.titulo}</h3>
              <p class="mt-2 flex-1 text-sm text-muted-foreground">{c.data.resumen}</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                <span class="font-mono">{c.data.paginasNorma}</span>
                {c.data.calculadoras.length > 0 && <span class="rounded bg-chart-2/20 px-1.5 py-0.5 font-medium text-foreground">{c.data.calculadoras.length} calculadora{c.data.calculadoras.length > 1 ? 's' : ''}</span>}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    apendices.length > 0 && (
      <section class="mt-12" aria-labelledby="h-apend">
        <h2 id="h-apend" class="text-2xl font-bold tracking-tight">Apéndices</h2>
        <p class="mt-1 text-sm text-muted-foreground">Material complementario del Título C: modelos puntal-tensor, anclajes, factores alternativos y más.</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {apendices.map((c) => (
            <li>
              <a href={`/titulo-c/${c.id}`} class="group block h-full rounded-xl border bg-card p-5 transition hover:border-primary/50 hover:shadow-md">
                <span class="font-mono text-lg font-bold text-primary">{c.data.codigo}</span>
                <h3 class="mt-1 font-semibold leading-snug group-hover:text-primary">{c.data.titulo}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{c.data.resumen}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-12 rounded-2xl border bg-muted/30 p-6" aria-labelledby="h-calc">
    <h2 id="h-calc" class="text-xl font-bold tracking-tight">Herramientas interactivas</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        calculadorasDe('c').map((c) => (
          <li class="flex items-start gap-3 rounded-lg border bg-card p-3 text-sm">
            <span class="mt-0.5 rounded bg-chart-2/25 px-1.5 py-0.5 font-mono text-xs">{c.secciones.split(' ')[0]}</span>
            <div>
              <p class="font-medium">{c.nombre}</p>
              <p class="text-xs text-muted-foreground">{c.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <a href="/titulo-c/calculadoras" class="mt-4 inline-block text-sm font-medium text-primary hover:underline">Abrir todas las calculadoras →</a>
  </section>
</TituloLayout>
