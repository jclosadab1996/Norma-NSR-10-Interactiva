---
import { getCollection } from 'astro:content';
import CapituloVista from '../../components/layout/CapituloVista.astro';

export async function getStaticPaths() {
  const todos = (await getCollection('titulo-c')).sort((a, b) => a.data.orden - b.data.orden || a.id.localeCompare(b.id));
  return todos.map((entry, i) => ({
    params: { capitulo: entry.id },
    props: { entry, anterior: todos[i - 1], siguiente: todos[i + 1] },
  }));
}

const { entry, anterior, siguiente } = Astro.props;
---

<CapituloVista titulo="c" entry={entry} anterior={anterior} siguiente={siguiente} />
