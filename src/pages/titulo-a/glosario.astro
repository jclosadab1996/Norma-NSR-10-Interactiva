---
import TituloLayout from '../../layouts/TituloLayout.astro';
import Glosario from '../../components/calc/Glosario';
import { definiciones, simbolos } from '../../data/glosario';
---

<TituloLayout titulo="a"
  title="Glosario y nomenclatura del Título A"
  description="Todas las definiciones (A.13.1) y los símbolos (A.13.2) del Título A de la NSR-10, con búsqueda, filtro por tema e índice alfabético."
  actual="a13"
  ancho="amplio"
>
  <header class="mb-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Título A · Capítulo A.13</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">Glosario y nomenclatura</h1>
    <p class="mt-3 max-w-3xl text-muted-foreground">
      Las <strong>{definiciones.length} definiciones</strong> de A.13.1 y los <strong>{simbolos.length} símbolos</strong> de A.13.2, tal como los
      escribe la norma. Busca por término, por símbolo (Fa, TC, R0…) o por cualquier palabra de la definición. Para aprender a usarlos, lee
      el <a href="/titulo-a/a13" class="font-medium text-primary underline-offset-4 hover:underline">Capítulo A.13 explicado</a>.
    </p>
  </header>
  <Glosario client:load />
</TituloLayout>
