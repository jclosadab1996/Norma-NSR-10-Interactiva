---
import { getCollection } from 'astro:content';
import TituloLayout from '../../layouts/TituloLayout.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from '../../lib/utils';
import { calculadorasDe } from '../../data/calculadoras';

const todos = (await getCollection('titulo-b')).sort((a, b) => a.data.orden - b.data.orden || a.id.localeCompare(b.id));
const capitulos = todos.filter((e) => e.data.tipo === 'capitulo');
const apendices = todos.filter((e) => e.data.tipo === 'apendice');

const NIVEL = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado' } as const;
const NIVEL_CLASE = {
  basico: 'bg-ok/15 text-ok',
  intermedio: 'bg-warn/15 text-warn',
  avanzado: 'bg-danger/15 text-danger',
} as const;

const flujo = [
  ['1', 'Definir las cargas', 'B.1', 'Alcance del Título, integridad estructural y qué cargas actúan.'],
  ['2', 'Cargas muertas', 'B.3', 'Peso propio, acabados, muros no estructurales y equipos fijos.'],
  ['3', 'Cargas vivas', 'B.4', 'Ocupación, reducciones, empozamiento de agua y granizo.'],
  ['4', 'Empuje y viento', 'B.5 · B.6', 'Empuje de tierra, presión hidrostática y fuerzas de viento.'],
  ['5', 'Combinar las cargas', 'B.2', 'Combinaciones de resistencia y de esfuerzos de trabajo (con el sismo del Título A).'],
] as const;
---

<TituloLayout titulo="b"
  title="Título B — Cargas"
  description="Guía interactiva del Título B de la NSR-10: combinaciones de carga, cargas muertas y vivas, empuje de tierra y fuerzas de viento, con ejemplos y calculadoras."
>
  <header class="rounded-2xl border bg-gradient-to-br from-primary/10 via-background to-chart-2/10 p-6 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Título B</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">Cargas</h1>
    <p class="mt-4 max-w-3xl text-muted-foreground">
      Define qué fuerzas debe resistir una edificación además del sismo: el peso de lo que la compone (cargas muertas), el de las
      personas y los objetos (cargas vivas), el empuje del suelo y del agua, y el viento. También fija cómo se mayoran y se
      combinan para diseñar por el método de la resistencia o de los esfuerzos de trabajo.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`/titulo-b/${capitulos[0]?.id ?? 'b1'}`} class={cn(buttonVariants())}>Empezar por B.1</a>
      <a href="/titulo-b/calculadoras" class={cn(buttonVariants({ variant: 'outline' }))}>Calculadoras</a>
      <a href="/titulo-b/glosario" class={cn(buttonVariants({ variant: 'outline' }))}>Glosario</a>
    </div>
  </header>

  <section class="mt-10" aria-labelledby="h-flujo">
    <h2 id="h-flujo" class="text-2xl font-bold tracking-tight">De las cargas al diseño, de un vistazo</h2>
    <p class="mt-1 text-sm text-muted-foreground">Ruta recomendada para determinar las cargas de diseño de una edificación.</p>
    <ol class="mt-5 grid gap-3 md:grid-cols-5">
      {
        flujo.map(([n, t, ref, d]) => (
          <li class="relative rounded-xl border bg-card p-4">
            <span class="absolute -top-3 left-4 grid size-6 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground">{n}</span>
            <p class="mt-1 font-semibold leading-snug">{t}</p>
            <p class="mt-1 font-mono text-xs text-muted-foreground">§ {ref}</p>
            <p class="mt-2 text-sm text-muted-foreground">{d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="h-caps">
    <h2 id="h-caps" class="text-2xl font-bold tracking-tight">Capítulos</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {
        capitulos.map((c) => (
          <li>
            <a href={`/titulo-b/${c.id}`} class="group flex h-full flex-col rounded-xl border bg-card p-5 transition hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-lg font-bold text-primary">{c.data.codigo}</span>
                <span class={`rounded-full px-2 py-0.5 text-xs ${NIVEL_CLASE[c.data.nivel]}`}>{NIVEL[c.data.nivel]}</span>
              </div>
              <h3 class="mt-2 font-semibold leading-snug group-hover:text-primary">{c.data.titulo}</h3>
              <p class="mt-2 flex-1 text-sm text-muted-foreground">{c.data.resumen}</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                <span class="font-mono">{c.data.paginasNorma}</span>
                {c.data.calculadoras.length > 0 && <span class="rounded bg-chart-2/20 px-1.5 py-0.5 font-medium text-foreground">{c.data.calculadoras.length} calculadora{c.data.calculadoras.length > 1 ? 's' : ''}</span>}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    apendices.length > 0 && (
      <section class="mt-12" aria-labelledby="h-apend">
        <h2 id="h-apend" class="text-2xl font-bold tracking-tight">Apéndices</h2>
        <p class="mt-1 text-sm text-muted-foreground">Material complementario del Título B.</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {apendices.map((c) => (
            <li>
              <a href={`/titulo-b/${c.id}`} class="group block h-full rounded-xl border bg-card p-5 transition hover:border-primary/50 hover:shadow-md">
                <span class="font-mono text-lg font-bold text-primary">{c.data.codigo}</span>
                <h3 class="mt-1 font-semibold leading-snug group-hover:text-primary">{c.data.titulo}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{c.data.resumen}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-12 rounded-2xl border bg-muted/30 p-6" aria-labelledby="h-calc">
    <h2 id="h-calc" class="text-xl font-bold tracking-tight">Herramientas interactivas</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        calculadorasDe('b').map((c) => (
          <li class="flex items-start gap-3 rounded-lg border bg-card p-3 text-sm">
            <span class="mt-0.5 rounded bg-chart-2/25 px-1.5 py-0.5 font-mono text-xs">{c.secciones.split(' ')[0]}</span>
            <div>
              <p class="font-medium">{c.nombre}</p>
              <p class="text-xs text-muted-foreground">{c.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <a href="/titulo-b/calculadoras" class="mt-4 inline-block text-sm font-medium text-primary hover:underline">Abrir todas las calculadoras →</a>
  </section>
</TituloLayout>
