---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from '../components/ui/button';
import { TITULOS } from '../data/titulos';
import { CALCULADORAS } from '../data/calculadoras';
import { getCollection } from 'astro:content';
import { cn } from '../lib/utils';

const capitulos = (await getCollection('titulo-a')).filter((c) => c.data.tipo === 'capitulo');
const capitulosB = (await getCollection('titulo-b')).filter((c) => c.data.tipo === 'capitulo');
const capitulosC = (await getCollection('titulo-c')).filter((c) => c.data.tipo === 'capitulo');
const capitulosD = (await getCollection('titulo-d')).filter((c) => c.data.tipo === 'capitulo');

const pilares = [
  {
    titulo: 'Explicado en lenguaje claro',
    texto: 'Cada capítulo traduce el texto normativo a ideas claras, siempre indicando la sección exacta (A.2.6, A.4.3…) y la página de la norma.',
  },
  {
    titulo: 'Ejemplos resueltos paso a paso',
    texto: 'Casos numéricos con edificaciones reales: desde ubicar un sitio en el mapa de amenaza hasta repartir la fuerza sísmica por pisos.',
  },
  {
    titulo: 'Calculadoras que usan las fórmulas de la norma',
    texto: 'Espectro de diseño, período fundamental, fuerza horizontal equivalente, deriva… cambia un dato y mira cómo responde el resultado.',
  },
];
---

<BaseLayout
  title="NSR-10 Interactiva — entiende el Reglamento Colombiano de Construcción Sismo Resistente"
  description="Web interactiva para detallar y entender más fácil la NSR-10: explicaciones, ejemplos resueltos y calculadoras. Títulos A, B, C y D disponibles."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background:radial-gradient(60rem_30rem_at_80%_-10%,color-mix(in_oklab,var(--primary)_18%,transparent),transparent),radial-gradient(40rem_24rem_at_0%_100%,color-mix(in_oklab,var(--chart-2)_14%,transparent),transparent)]"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:py-20">
      <div>
        <p class="mb-3 inline-flex items-center gap-2 rounded-full border bg-background/70 px-3 py-1 text-xs font-medium text-muted-foreground">
          <span class="size-1.5 rounded-full bg-ok"></span> Títulos A, B, C y D disponibles · E–K en camino
        </p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Entiende la <span class="text-primary">NSR-10</span> sin perderte en el texto de la norma
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
          Esta web está hecha para <strong class="font-semibold text-foreground">detallar y entender más fácil</strong> el Reglamento
          Colombiano de Construcción Sismo Resistente. Recorre cada Título con explicaciones, ejemplos, tablas y calculadoras
          interactivas, siempre ligado a la sección original de la norma.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/titulo-a" class={cn(buttonVariants({ size: 'lg' }))}>Empezar con el Título A</a>
          <a href="/titulo-b" class={cn(buttonVariants({ size: 'lg', variant: 'outline' }))}>Título B · Cargas</a>
        </div>
        <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 text-sm">
          <div><dt class="text-muted-foreground">Capítulos (Títulos A a D)</dt><dd class="text-2xl font-bold">{capitulos.length + capitulosB.length + capitulosC.length + capitulosD.length}</dd></div>
          <div><dt class="text-muted-foreground">Calculadoras</dt><dd class="text-2xl font-bold">{CALCULADORAS.length}</dd></div>
          <div><dt class="text-muted-foreground">Títulos de la norma</dt><dd class="text-2xl font-bold">{TITULOS.length}</dd></div>
        </dl>
      </div>

      <!-- Ilustración: espectro de diseño esquemático -->
      <figure class="rounded-2xl border bg-card p-4 shadow-sm" aria-label="Esquema del espectro de diseño de la NSR-10">
        <svg viewBox="0 0 420 260" class="h-auto w-full" role="img" aria-labelledby="fig-esp-t fig-esp-d">
          <title id="fig-esp-t">Espectro elástico de diseño</title>
          <desc id="fig-esp-d">Aceleración Sa contra período T: meseta, rama descendente 1/T y rama 1/T².</desc>
          <g stroke="currentColor" class="text-border" stroke-width="1">
            <line x1="46" y1="20" x2="46" y2="210" />
            <line x1="46" y1="210" x2="400" y2="210" />
            {[0, 1, 2, 3].map((i) => <line x1="46" y1={60 + i * 50} x2="400" y2={60 + i * 50} stroke-dasharray="3 5" opacity="0.6" />)}
          </g>
          <path d="M46 150 L70 70 L130 70 C 190 70 220 108 250 130 C 290 158 330 182 372 194 L 400 197" fill="none" stroke="var(--primary)" stroke-width="3.2" stroke-linejoin="round" />
          <path d="M46 150 L70 70 L130 70 C 190 70 220 108 250 130 C 290 158 330 182 372 194 L 400 197 L 400 210 L 46 210 Z" fill="var(--primary)" opacity="0.08" />
          <g class="fill-muted-foreground" font-size="11" font-family="var(--font-sans)">
            <text x="70" y="226" text-anchor="middle">T₀</text>
            <text x="130" y="226" text-anchor="middle">T_C</text>
            <text x="290" y="226" text-anchor="middle">T_L</text>
            <text x="396" y="226" text-anchor="end">T (s)</text>
            <text x="38" y="30" text-anchor="end">Sa</text>
            <text x="160" y="60" fill="currentColor">Sa = 2.5·Aa·Fa·I</text>
            <text x="248" y="118" fill="currentColor">1.2·Av·Fv·I / T</text>
            <text x="300" y="178" fill="currentColor">… / T²</text>
          </g>
          <g stroke="currentColor" class="text-muted-foreground" stroke-dasharray="2 4" opacity="0.7">
            <line x1="70" y1="70" x2="70" y2="210" /><line x1="130" y1="70" x2="130" y2="210" /><line x1="290" y1="152" x2="290" y2="210" />
          </g>
        </svg>
        <figcaption class="mt-2 text-center text-xs text-muted-foreground">Espectro de diseño (A.2.6) — esquema ilustrativo</figcaption>
      </figure>
    </div>
  </section>

  <!-- ¿Qué es? -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">¿Qué es la NSR-10?</h2>
        <p class="mt-4 text-muted-foreground">
          La NSR-10 es el Reglamento Colombiano de Construcción Sismo Resistente, adoptado por el Decreto 926 de 2010 con base en la
          Ley 400 de 1997. Fija los requisitos mínimos que deben cumplir el diseño y la construcción de edificaciones para que resistan
          sismos sin poner en riesgo la vida de las personas, y limita el daño en los eventos más frecuentes.
        </p>
        <p class="mt-3 text-muted-foreground">
          Está dividida en <strong class="text-foreground">11 Títulos (A a K)</strong>. El Título A es la base de todos: define cuánto
          tiembla el suelo en cada lugar, cómo se transforma eso en fuerzas sobre la edificación y qué verificaciones deben cumplirse. El Título B
          define las cargas (muertas, vivas, viento, empuje de tierra) y cómo combinarlas; el Título C trata el diseño de las estructuras de concreto y el Título D el de la mampostería estructural.
        </p>
      </div>
      <ul class="grid gap-4">
        {pilares.map((p, i) => (
          <li class="flex gap-4 rounded-xl border bg-card p-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 font-bold text-primary">{i + 1}</span>
            <div>
              <h3 class="font-semibold">{p.titulo}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{p.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Títulos -->
  <section class="border-y bg-muted/30">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Los Títulos de la norma</h2>
          <p class="mt-2 text-muted-foreground">Cada Título tiene su propia pestaña. Por ahora están completos los Títulos A, B, C y D.</p>
        </div>
        <a href="/titulos" class="text-sm font-medium text-primary hover:underline">Ver todos →</a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {TITULOS.slice(0, 6).map((t) => (
          <li>
            <a
              href={`/${t.slug}`}
              class="group flex h-full flex-col rounded-xl border bg-card p-5 transition hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md"
            >
              <div class="flex items-center justify-between">
                <span class={`text-3xl font-black ${t.acento}`}>{t.letra}</span>
                <span class:list={['rounded-full px-2 py-0.5 text-xs', t.estado === 'disponible' ? 'bg-ok/15 text-ok' : 'bg-muted text-muted-foreground']}>
                  {t.estado === 'disponible' ? 'Disponible' : 'Próximamente'}
                </span>
              </div>
              <h3 class="mt-3 font-semibold leading-snug group-hover:text-primary">{t.nombre}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{t.resumen}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Cómo empezar -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Cómo recorrer el Título A</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-4">
      <li class="rounded-xl border bg-card p-5"><p class="text-sm font-semibold text-primary">1 · Introducción</p><p class="mt-1 text-sm text-muted-foreground">A.1 — alcance, procedimiento de diseño y responsabilidades.</p></li>
      <li class="rounded-xl border bg-card p-5"><p class="text-sm font-semibold text-primary">2 · La amenaza</p><p class="mt-1 text-sm text-muted-foreground">A.2 — Aa, Av, tipo de suelo, importancia y espectro de diseño.</p></li>
      <li class="rounded-xl border bg-card p-5"><p class="text-sm font-semibold text-primary">3 · La estructura</p><p class="mt-1 text-sm text-muted-foreground">A.3 a A.6 — sistemas, configuración, análisis y deriva.</p></li>
      <li class="rounded-xl border bg-card p-5"><p class="text-sm font-semibold text-primary">4 · Casos especiales</p><p class="mt-1 text-sm text-muted-foreground">A.7 a A.13 — suelo-estructura, no estructurales, existentes, instrumentación y glosario.</p></li>
    </ol>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/titulo-a" class={cn(buttonVariants({ size: 'lg' }))}>Ir al Título A</a>
      <a href="/titulo-a/municipios" class={cn(buttonVariants({ size: 'lg', variant: 'ghost' }))}>Buscar mi municipio →</a>
      <a href="/titulo-b" class={cn(buttonVariants({ size: 'lg', variant: 'ghost' }))}>Ir al Título B (Cargas) →</a>
      <a href="/titulo-c" class={cn(buttonVariants({ size: 'lg', variant: 'ghost' }))}>Ir al Título C (Concreto) →</a>
      <a href="/titulo-d" class={cn(buttonVariants({ size: 'lg', variant: 'ghost' }))}>Ir al Título D (Mampostería) →</a>
    </div>
  </section>
</BaseLayout>
